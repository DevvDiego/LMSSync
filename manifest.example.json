{
    "manifest_version": 3,
    "name": "Extensión SCORM",
    "version": "1.7.0",
    "description": "Accede a datos de SCORM",
    "content_scripts": [
      {
        "matches": ["https://*/*"],
        "js": ["content-script.js"],
        "run_at": "document_end"
      }
    ],
    "permissions": ["scripting", "activeTab", "storage"],
    "host_permissions": [ //! REMOVE COMMENTS ON BUILD, JUST FOR REFERENCE ON DEV MODE
      "https://*/*", //page to obtain courses from
      "*://*/backend/*" //API server
    ],
    "action": {
      "default_popup": "index.html"
    },
    "web_accessible_resources": [{
      "resources": ["private.json"],
      "matches": ["<all_urls>"]
    }]
}